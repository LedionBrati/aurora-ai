# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ─── WhatsApp (360dialog) ─────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Gmail API (OAuth2) ───────────────────────────────────
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-client-secret-here
GMAIL_REFRESH_TOKEN=your-refresh-token-here
GMAIL_USER_EMAIL=your-gmail-address@gmail.com

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Dashboard auth (required — the app refuses to start without it) ──
# Protects /inbox, / and every /api route. The inbox shows real guest
# conversations and can send messages as the business, so it is never
# served unprotected. Minimum 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=generate-a-long-random-password-here

# ─── Server ───────────────────────────────────────────────
PORT=3000

# ─── Local Development (ngrok) ────────────────────────────
# To expose localhost for WhatsApp webhook testing:
#   npx ngrok http 3000
# Then register the printed HTTPS URL in 360dialog Hub → Webhook URL:
#   https://<your-id>.ngrok-free.app/webhook/whatsapp
#
# Gmail uses polling locally — no ngrok needed for Gmail.


